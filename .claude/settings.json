      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/heejinchae/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/heejinchae/.headroom/bin/rtk init -g --auto-patch >/dev/null 2>&1 || true"
          }
